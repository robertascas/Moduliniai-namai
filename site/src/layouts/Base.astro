---
import Logo from "../components/Logo.astro";
import Arrow from "../components/Arrow.astro";
import { K, NAV, BRAND, TEL, EMAIL, modelHref } from "../lib/site";

interface Props { title: string; description: string; current?: string; }
const { title, description, current } = Astro.props;
const fullTitle = title === BRAND ? `${BRAND} · Moduliniai namai` : `${title} · ${BRAND}`;
---
<!doctype html>
<html lang="lt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="claude:viewport-fit-sides" content="cover">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600;700&family=Schibsted+Grotesk:wght@700;800;900&display=swap">
  <link rel="stylesheet" href="css/site.css">
</head>
<body>
  <div class="proto">
    <div class="wrap">
      <span>PROTOTIPAS v0.2 · pavadinimas, kainos ir objektai pavyzdiniai</span>
      <a href="kainynas.html">Kainyno valdymo demo →</a>
    </div>
  </div>

  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="index.html" aria-label={`${BRAND}, pradžia`}><Logo />{BRAND}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Meniu</button>
      <nav class="nav" id="nav" data-open="false" aria-label="Pagrindinis meniu">
        {NAV.map((n) => <a href={n.href} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <a class="head-tel" href={`tel:${TEL.replace(/\s/g, "")}`}>{TEL}</a>
      <a class="btn btn-primary btn-sm btn-cta" href="konfiguratorius.html">Apskaičiuoti kainą <Arrow /></a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-brand">
        <a class="brand" href="index.html"><Logo />{BRAND}</a>
        <p>Moduliniai karkasiniai namai, pagaminti sausame angare Vilniaus rajone ir sumontuoti visoje Lietuvoje.</p>
      </div>
      <div class="foot-col">
        <h4>Namai</h4>
        <ul>
          {K.modeliai.map((m) => <li><a href={`modelis-${m.pavadinimas.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-")}.html`}>{m.pavadinimas}</a></li>)}
        </ul>
      </div>
      <div class="foot-col">
        <h4>Informacija</h4>
        <ul>
          <li><a href="eiga.html">Kaip statome</a></li>
          <li><a href="konfiguratorius.html">Kaina</a></li>
          <li><a href="duk.html">DUK ir garantija</a></li>
          <li><a href="darbai.html">Atlikti darbai</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h4>Kontaktai</h4>
        <ul>
          <li>{TEL}</li>
          <li>{EMAIL}</li>
          <li>I–V 8:00–17:00</li>
          <li><a href="kontaktai.html">Užklausos forma</a></li>
        </ul>
      </div>
      <div class="foot-word" aria-hidden="true">{BRAND}</div>
      <div class="foot-legal">
        <span>© 2026 {BRAND} (darbinis pavadinimas)</span>
        <span>Privatumo politika · Slapukai · EN</span>
      </div>
    </div>
  </footer>

  <div class="callbar">
    <a class="btn btn-line btn-sm" href={`tel:${TEL.replace(/\s/g, "")}`}>Skambinti</a>
    <a class="btn btn-primary btn-sm" href="konfiguratorius.html">Apskaičiuoti kainą</a>
  </div>

  <script is:inline id="kainynas" type="application/json" set:html={JSON.stringify(K)}></script>
  <script is:inline src="js/app.js" defer></script>
</body>
</html>
