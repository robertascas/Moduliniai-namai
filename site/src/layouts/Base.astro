---
import Logo from "../components/Logo.astro";
import fontsCss from "../../public/css/fonts.css?raw";
import siteCss from "../../public/css/site.css?raw";
import Arrow from "../components/Arrow.astro";
import { imone, produktai, NAV, BRAND, SITE, telHref, productHref, orgSchema } from "../lib/site";

interface Props { title: string; description: string; path: string; current?: string; image?: string; schema?: object[]; }
const { title, description, path, current, image = "og.jpg", schema = [] } = Astro.props;
const canonical = `${SITE}/${path === "index.html" ? "" : path.replace(/\.html$/, "")}`;
const ld = [orgSchema(), ...schema];
const tel = imone.telefonai[0];
---
<!doctype html>
<html lang="lt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  {import.meta.env.PUBLIC_NOINDEX === "1" && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="lt_LT">
  <meta property="og:site_name" content={BRAND}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${SITE}/${image}`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0F4C45">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="apple-touch-icon.png">
  <link rel="preload" href="fonts/albert-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="fonts/albert-sans-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
  <style is:inline set:html={fontsCss + siteCss}></style>
  {ld.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)}></script>)}
</head>
<body>
  {import.meta.env.PUBLIC_NOINDEX === "1" && (
    <div class="proto">
      <div class="wrap">
        <span>Testinė versija · modeliai, nuotraukos ir išplanavimai iš gamybos partnerio katalogo</span>
      </div>
    </div>
  )}

  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="index.html" aria-label={`${BRAND}, pradžia`}><Logo /></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">Meniu</button>
      <nav class="nav" id="nav" data-open="false" aria-label="Pagrindinis meniu">
        {NAV.map((n) => <a href={n.href} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
      </nav>
      <a class="btn btn-spruce btn-sm btn-head" href={telHref(tel)}>{tel}</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-brand">
        <a class="brand" href="index.html" aria-label={`${BRAND}, pradžia`}><Logo /></a>
        <p>Moduliniai namai, pirtys, lauko sandėliukai, karkasiniai namai ir garažai. {imone.vietove}.</p>
      </div>
      <div class="foot-col">
        <p class="foot-h">Gaminame</p>
        <ul>{produktai.map((p) => <li><a href={productHref(p)}>{p.pavadinimas}</a></li>)}</ul>
      </div>
      <div class="foot-col">
        <p class="foot-h">Informacija</p>
        <ul>
          <li><a href="index.html#irengimas">Įrengimo lygiai</a></li>
          <li><a href="index.html#eiga">Kaip dirbame</a></li>
          <li><a href="index.html#duk">DUK</a></li>
          <li><a href="kontaktai.html">Užklausa</a></li>
        </ul>
      </div>
      <div class="foot-col wide">
        <p class="foot-h">Kontaktai</p>
        <ul>
          {imone.telefonai.map((t) => <li><a href={telHref(t)}>{t}</a></li>)}
          <li><a href={`mailto:${imone.elPastas}`}>{imone.elPastas}</a></li>
          <li>{imone.vietove}</li>
        </ul>
      </div>
      <div class="foot-legal">
        <span>© 2026 {BRAND}</span>
        <a href="privatumo-politika.html">Privatumo politika</a>
      </div>
    </div>
  </footer>

  <div class="callbar">
    <a class="btn btn-ghost btn-sm" href={telHref(tel)}>Skambinti</a>
    <a class="btn btn-amber btn-sm" href="kontaktai.html">Aptarti projektą</a>
  </div>

  <script is:inline src="js/app.js" defer></script>
</body>
</html>
