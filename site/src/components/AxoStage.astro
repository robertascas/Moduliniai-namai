---
import { K } from "../lib/site";
interface Props { id: string; model: string; fasadas?: string; stogas?: string; start?: string; dims?: boolean; controls?: boolean; label: string; }
const { id, model, fasadas = "maumedis", stogas = "slaitinis", start = "", dims = false, controls = true, label } = Astro.props;
const f = K.fasadai.find((x) => x.id === fasadas) ?? K.fasadai[0];
---
<figure class="stage" style="margin:0">
  <svg class="axo" id={id} data-axo data-model={model} data-fasadas={fasadas} data-stogas={stogas} data-start={start} data-dims={dims ? "true" : "false"} role="img" aria-label={label} viewBox="0 0 600 420"></svg>
  {controls && (
    <figcaption class="stage-bar">
      <button class="chip-btn" type="button" data-explode-for={id} aria-pressed="false">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="6" width="4" height="9"/><rect x="6" y="3" width="4" height="9"/><rect x="11" y="0.8" width="4" height="9"/></svg>
        <span>Išskaidyti į modulius</span>
      </button>
      <div class="swatches" role="group" aria-label="Fasado apdaila">
        <span class="tag" data-swatch-label={id}>{f.pavadinimas}</span>
        {K.fasadai.map((x) => (
          <button class="swatch" type="button" data-swatch-for={id} data-fasadas={x.id} aria-pressed={x.id === fasadas ? "true" : "false"} aria-label={x.pavadinimas} title={x.pavadinimas} style={`background:${x.spalvos[0]}`}></button>
        ))}
      </div>
    </figcaption>
  )}
</figure>
