---
import { K } from "../lib/site";
const total = 21;
const weeks = Array.from({ length: total / 3 + 1 }, (_, i) => i * 3);
const kind = (pav: string) => (/gamyba/i.test(pav) ? "factory" : /pamatai|montavimas|sujungimai/i.test(pav) ? "site" : "");
const { compact = false } = Astro.props;
---
<div class="gantt-scroll">
  <div class="gantt" role="table" aria-label="Statybos eiga savaitėmis">
    <div class="tag" role="columnheader" style="align-self:end;padding-bottom:6px">Etapas</div>
    <div class="gantt-axis" role="columnheader">
      {weeks.map((w) => <span style={`left:${(w / total) * 100}%`}>{w} sav.</span>)}
    </div>
    {K.eiga.map((e) => (
      <div class="gantt-row" role="row">
        <div class="g-name" role="cell">
          <b>{e.pav}</b>
          {!compact && <span class="muted" style="font-size:14.5px;line-height:1.4">{e.aprasymas}</span>}
        </div>
        <div class="g-track" role="cell">
          <div class={`g-bar ${kind(e.pav)}`} style={`left:${(e.nuo / total) * 100}%;width:${((e.iki - e.nuo) / total) * 100}%`}>
            {e.iki - e.nuo} sav.
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
<div class="gantt-legend tag">
  <span><i style="background:var(--ink)"></i>Biuras ir dokumentai</span>
  <span><i style="background:var(--cobalt)"></i>Gamykla</span>
  <span><i style="background:var(--larch)"></i>Sklypas</span>
</div>
