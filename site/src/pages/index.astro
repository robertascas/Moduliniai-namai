---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ModelCard from "../components/ModelCard.astro";
import Levels from "../components/Levels.astro";
import Tech from "../components/Tech.astro";
import { imone, produktai, turinys, katalogas, productHref, img, kimg, isViz, telHref, faqSchema } from "../lib/site";
const rinktiniai = ["namelis-30", "namas-50", "pusynas-60", "horizontas-91"].map((id) => katalogas.modeliai.find((x) => x.id === id)!);
---
<Base
  path="index.html"
  title="Moduliniai namai, pirtys ir karkasiniai pastatai | Šiltas karkasas"
  description="Moduliniai namai, modulinės pirtys, lauko sandėliukai, karkasiniai namai ir garažai. Gamyba kontroliuojamose patalpose, sąmata iš anksto. Vilnius ir Vilniaus rajonas."
  schema={[faqSchema(turinys.duk)]}
>
  <section class="hero">
    <img src={kimg("namas-40-siaure")} srcset={`${kimg("namas-40-siaure", true)} 800w, ${kimg("namas-40-siaure")} 1241w`} sizes="100vw" alt="Modulinis namas su apšviestais langais ant kopos saulėlydžio metu" width="1241" height="910" fetchpriority="high">
    <div class="wrap">
      <span class="eyebrow">{imone.vietove}</span>
      <h1>Moduliniai namai, pirtys ir nameliai ant vandens</h1>
      <p class="lead">Projektuojame ir statome ilgaamžius, šiltus bei modernius karkasinius namus, pirtis, vasarnamius ir garažus. Nuo pamatų iki raktų pridavimo.</p>
      <div class="actions">
        <a class="btn btn-amber" href="kontaktai.html">Aptarti projektą <Arrow /></a>
        <a class="btn btn-ghost" href={telHref(imone.telefonai[0])}>{imone.telefonai[0]}</a>
      </div>
    </div>
  </section>

  <div class="strip">
    <div class="wrap">
      <div><b>Kontroliuojamos patalpos</b><span>Gamyba be lietaus ir netikėtumų sklype</span></div>
      <div><b>Kelios savaitės</b><span>Nuo idėjos iki pastatymo sklype</span></div>
      <div><b>Sąmata iš anksto</b><span>Jokių paslėptų mokesčių</span></div>
      <div><b>Vilnius ir rajonas</b><span>Pristatymas ir montavimas</span></div>
    </div>
  </div>

  <section class="section" id="gaminame">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Ką gaminame</span>
        <h2>Šilti pastatai gyvenimui, poilsiui ir ūkiui.</h2>
        <p class="lead">Su kiekvienu klientu deriname išplanavimą, spalvas ir medžiagas. Statome pagal jūsų arba mūsų siūlomus projektus.</p>
      </div>
    </div>
    <div class="splits">
      {produktai.map((p) => (
        <a class="split" href={productHref(p)}>
          <div class="split-img"><img src={img(p.nuotrauka, true)} alt={p.alt} width="800" height="587" loading="lazy">{isViz(p.nuotrauka) && <span class="viz-note">Vizualizacija</span>}</div>
          <div class="split-body">
            <h3>{p.pavadinimas}</h3>
            <p>{p.trumpai}</p>
            <ul>{p.punktai.slice(0, 3).map((x) => <li>{x}</li>)}</ul>
            <span class="split-more">Plačiau <Arrow /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section surface" id="modeliai">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Moduliniai namai</span>
        <h2>12 modelių nuo 30 iki 124 m².</h2>
        <a class="split-more side" href="moduliniai-namai.html" style="color:var(--ink)">Visi modeliai <Arrow /></a>
      </div>
      <div class="mgrid four">{rinktiniai.map((m) => <ModelCard m={m} />)}</div>
    </div>
  </section>

  <section class="section" id="irengimas">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Įrengimo lygiai ir kainos</span>
        <h2>Trys lygiai, nuo šilto karkaso iki raktų.</h2>
        <p class="lead">Visi lygiai gaminami tomis pačiomis sąlygomis. Skiriasi tik tai, kiek vidaus darbų atliekame mes.</p>
      </div>
      <Levels />
    </div>
  </section>

  <section class="section surface" id="technika">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Techniniai duomenys</span>
        <h2>Šilta siena, šiltas stogas, šiltos grindys.</h2>
      </div>
      <Tech />
    </div>
  </section>

  <section class="section" id="privalumai">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Kodėl verta rinktis mus</span>
        <h2>Gaminame po stogu, o ne jūsų sklype.</h2>
      </div>
      <div class="perks">
        {turinys.privalumai.map((x) => (
          <div class="perk"><h3>{x.pavadinimas}</h3><p>{x.tekstas}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="statement">
    <img src={kimg("interjeras")} alt="Šviesi modulinio namo svetainė su virtuve ir antresole" width="1600" height="1559" loading="lazy">
    <div class="wrap">
      <span class="eyebrow" style="color:rgba(255,255,255,.8)">Visas darbas vienose rankose</span>
      <h2>Nuo pamatų iki raktų pridavimo pasirūpinsime viskuo.</h2>
      <div class="actions"><a class="btn btn-amber" href="kontaktai.html">Aptarti projektą <Arrow /></a></div>
    </div>
  </section>

  <section class="section" id="eiga">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Kaip dirbame</span>
        <h2>Nuo idėjos iki pastatymo per kelias savaites.</h2>
      </div>
      <ol class="steps">
        {turinys.eiga.map((x) => <li><h3>{x.pavadinimas}</h3><p>{x.tekstas}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section surface" id="galerija">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Galerija</span>
        <h2>Pagaminti ir pastatyti namai.</h2>
        <a class="split-more side" href="galerija.html" style="color:var(--ink)">Visa galerija <Arrow /></a>
      </div>
      <div class="gallery strip-6">
        {katalogas.galerija.slice(0, 6).map((g) => <a class="gal-item" href="galerija.html"><img src={kimg(g.f, true)} alt={g.alt} loading="lazy"></a>)}
      </div>
    </div>
  </section>

  <section class="section" id="duk">
    <div class="wrap faq">
      <div class="faq-head">
        <span class="eyebrow">DUK</span>
        <h2>Dažniausi klausimai</h2>
        <p class="muted">Neradote atsakymo? Paskambinkite arba parašykite {imone.elPastas}.</p>
      </div>
      <div class="faq-list">
        {turinys.duk.map((q, i) => (
          <details open={i === 0}><summary>{q.klausimas}</summary><p>{q.atsakymas}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="wrap">
      <span class="eyebrow">Susisiekite</span>
      <h2>Aptarkime jūsų projektą.</h2>
      <div class="contact-list">
        {imone.telefonai.map((t) => <a href={telHref(t)}>{t}</a>)}
        <a href={`mailto:${imone.elPastas}`}>{imone.elPastas}</a>
        <small>{imone.vietove}</small>
      </div>
      <div class="actions"><a class="btn btn-amber" href="kontaktai.html">Užpildyti užklausą <Arrow /></a></div>
    </div>
  </section>
</Base>
