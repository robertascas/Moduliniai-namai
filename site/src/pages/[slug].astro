---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import ModelCard from "../components/ModelCard.astro";
import ModelPage from "../components/ModelPage.astro";
import Levels from "../components/Levels.astro";
import Tech from "../components/Tech.astro";
import { imone, produktai, turinys, katalogas, productHref, modelHref, img, kimg, planImg, isViz, telHref, faqSchema, crumbsSchema, type Produktas, type Modelis } from "../lib/site";

export function getStaticPaths() {
  return [
    ...produktai.map((p) => ({ params: { slug: p.slug }, props: { kind: "produktas", p } })),
    ...katalogas.modeliai.map((m) => ({ params: { slug: m.id }, props: { kind: "modelis", m } })),
  ];
}
const { kind, p, m } = Astro.props as { kind: string; p?: Produktas; m?: Modelis };

const faqIds: Record<string, string[]> = {
  namas: ["Kuo skiriasi", "Kokia namo energinė", "Kiek laiko", "Kaip mokama", "Kur pristatote", "Ar galima pasirinkti", "Ar bus papildomų"],
  pirtis: ["Kokią krosnelę", "Kuo skiriasi", "Kiek laiko", "Kur pristatote", "Ar bus papildomų"],
  sandeliukas: ["Kaip mokama", "Kiek laiko", "Kur pristatote", "Ar galima pasirinkti", "Ar bus papildomų"],
  karkasinis: ["Ką gaminate", "Ar galima pasirinkti", "Kur pristatote", "Kuo skiriasi", "Ar bus papildomų"],
  vanduo: ["Ar gaminate namelius", "Ar galima pasirinkti", "Kur pristatote", "Ar bus papildomų"],
};
const faq = p ? turinys.duk.filter((q) => faqIds[p.id].some((k) => q.klausimas.startsWith(k))) : [];
const others = p ? produktai.filter((x) => x.id !== p.id).slice(0, 3) : [];
const namelis = katalogas.modeliai.find((x) => x.id === "namelis-30")!;
const pirtiesPlanai = namelis.planai.filter((x) => x.var === "D" || x.var === "F");

const title = p ? `${p.seoTitle} | Šiltas karkasas` : `${m!.pavadinimas}: modulinis namas ${m!.plotas} m² | Šiltas karkasas`;
const description = p ? p.seoDescription : `${m!.pavadinimas}: ${m!.plotas} m², ${m!.miegamieji} miegam., stogo nuolydis ${m!.nuolydis}. ${m!.aprasymas[0]}`.slice(0, 158);
const path = p ? productHref(p) : modelHref(m!);
const crumbs = p
  ? [{ name: "Pradžia", path: "" }, { name: p.pavadinimas, path }]
  : [{ name: "Pradžia", path: "" }, { name: "Moduliniai namai", path: "moduliniai-namai.html" }, { name: m!.pavadinimas, path }];
const image = p ? (isViz(p.nuotrauka) ? "og.jpg" : `img/${p.nuotrauka}.webp`) : `img/k/${m!.nuotraukos[0].f}.webp`;
---
<Base path={path} current={p ? p.id : "namas"} title={title} description={description} image={image} schema={[...(faq.length ? [faqSchema(faq)] : []), crumbsSchema(crumbs)]}>
  {kind === "modelis" && m && <ModelPage m={m} />}

  {kind === "produktas" && p && (
    <>
      <section class="p-hero">
        <div class="p-hero-img">
          <img src={img(p.nuotrauka)} srcset={`${img(p.nuotrauka, true)} 800w, ${img(p.nuotrauka)} 1600w`} sizes="(max-width: 900px) 100vw, 50vw" alt={p.alt} width="1241" height="910" fetchpriority="high">
          {isViz(p.nuotrauka) && <span class="viz-note">Vizualizacija</span>}
        </div>
        <div class="p-hero-body">
          <span class="crumbs"><a href="index.html">Pradžia</a> / {p.pavadinimas}</span>
          <h1>{p.pavadinimas}</h1>
          <p class="lead">{p.trumpai}</p>
          <div class="actions">
            <a class="btn btn-amber" href={`kontaktai.html#${p.id}`}>Aptarti projektą <Arrow /></a>
            <a class="btn btn-ghost" href={telHref(imone.telefonai[0])}>{imone.telefonai[0]}</a>
          </div>
        </div>
      </section>

      {p.id === "namas" && (
        <section class="section" id="modeliai">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Modeliai</span>
              <h2>Nuo 30 iki 124 m².</h2>
              <p class="lead">Kiekvieną modelį galima pritaikyti: perkelti langus, apversti veidrodiškai, pasirinkti spalvą ir vidaus apdailą.</p>
            </div>
            <div class="filters" data-filters role="group" aria-label="Filtruoti pagal plotą">
              <button type="button" class="chip" data-f="all" aria-pressed="true">Visi</button>
              <button type="button" class="chip" data-f="0-45" aria-pressed="false">iki 45 m²</button>
              <button type="button" class="chip" data-f="46-80" aria-pressed="false">50–80 m²</button>
              <button type="button" class="chip" data-f="81-999" aria-pressed="false">nuo 90 m²</button>
            </div>
            {katalogas.serijos.map((s) => (
              <div class="series" data-series>
                <div class="series-head"><h3>{s.pavadinimas}</h3><p class="muted">{s.aprasymas}</p></div>
                <div class="mgrid">{katalogas.modeliai.filter((x) => x.serija === s.id).map((x) => <ModelCard m={x} />)}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="section surface">
        <div class="wrap">
          <div class="sec-head">
            <span class="eyebrow">Apie</span>
            <h2>{p.pavadinimas}</h2>
            <p class="lead">{p.aprasymas}</p>
          </div>
          <ul class="checks">{p.punktai.map((x) => <li>{x}</li>)}</ul>
        </div>
      </section>

      {p.id === "pirtis" && (
        <section class="section" id="dydziai">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Dydžiai</span>
              <h2>Trys pirčių dydžiai.</h2>
              <p class="lead">Dydį renkatės pagal tai, kiek žmonių pirtyje lankysis ir ar reikia poilsio kambario.</p>
            </div>
            <div class="sizes">
              {[["pirtis-3x4","3 × 4 m","12 m²","Kompaktiška pirtis su garine ir persirengimo patalpa."],["pirtis-5x5","5 × 5 m","25 m²","Erdvi pirtis su poilsio kambariu ir terasa po stogu."],["pirtis-4x6","4 × 6 m","24 m²","Pailga pirtis: garinė, dušas ir poilsio kambarys su dideliu langu."]].map(([f,d,a,t]) => (
                <article class="size">
                  <img src={img(f, true)} alt={`Modulinė pirtis ${d}, vizualizacija`} width="1000" height="781" loading="lazy">
                  <div class="size-body"><h3>{d} <span>{a}</span></h3><p class="muted">{t}</p></div>
                </article>
              ))}
            </div>
            <p class="note" style="margin-top:14px">Vaizdai yra vizualizacijos. Išplanavimą kiekvienam dydžiui deriname pagal jūsų pageidavimus.</p>
          </div>
        </section>
      )}

      {p.id === "pirtis" && (
        <section class="section surface" id="parinktys">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Techninės parinktys</span>
              <h2>Kiekvieną pirties detalę renkatės patys.</h2>
              <p class="lead">Žemiau parinktys, kurias suderiname prieš gamybą. Pasakykite, kaip pirtimi naudositės, ir pasiūlysime tinkamą derinį.</p>
            </div>
            <ul class="options">
              <li><b>Krosnelė</b><span>Malkinė arba elektrinė. Galią parenkame pagal garinės tūrį.</span></li>
              <li><b>Apšiltinimas</b><span>Pagal tai, ar pirtimi naudositės visus metus, ar tik šiltuoju sezonu.</span></li>
              <li><b>Gultų mediena</b><span>Pasirenkate medienos rūšį gultams ir sienų apdailai.</span></li>
              <li><b>Poilsio kambarys</b><span>Atskira patalpa poilsiui po garinės, su langu.</span></li>
              <li><b>Terasa</b><span>Po stogu arba atvira, dydis pagal sklypą.</span></li>
              <li><b>Dušas</b><span>Atskira dušo patalpa arba dušas prie garinės.</span></li>
            </ul>
          </div>
        </section>
      )}

      {p.id === "vanduo" && (
        <section class="section" id="variantai">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Pagrindas</span>
              <h2>Ant pontono arba ant plūdurų.</h2>
              <p class="lead">Abu variantai yra 20–25 m² ploto. Pagrindą parenkame pagal vandens telkinį ir tai, kaip namelis bus naudojamas.</p>
            </div>
            <div class="plan-pair">
              <article class="size">
                <img src={img("namelis-ant-pontono", true)} alt="Namelis ant pontono, vizualizacija" width="1000" height="639" loading="lazy">
                <div class="size-body"><h3>Ant pontono <span>20–25 m²</span></h3><p class="muted">Pontonas yra plokščias plaukiojantis pagrindas visu namelio plotu. Ant jo telpa ir terasa aplink namelį.</p></div>
              </article>
              <article class="size">
                <img src={img("namelis-ant-pluduru", true)} alt="Namelis ant plūdurų, vizualizacija" width="1000" height="639" loading="lazy">
                <div class="size-body"><h3>Ant plūdurų <span>20–25 m²</span></h3><p class="muted">Namelis stovi ant rėmo, kurį laiko plūdurai. Tai lengvesnė konstrukcija su terasa ir turėklais.</p></div>
              </article>
            </div>
            <p class="note" style="margin-top:14px">Vaizdai yra vizualizacijos. Išplanavimą, apdailą ir terasos dydį deriname pagal jūsų pageidavimus.</p>
          </div>
        </section>
      )}

      {p.id === "pirtis" && (
        <section class="section" id="isplanavimai">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Pirtis ŠK30 namelyje</span>
              <h2>Du išplanavimai su pirtimi.</h2>
              <p class="lead">ŠK30 namelis gaminamas ir kaip pirtis: su poilsio kambariu ir antresole arba su miegamaisiais svečiams. Fasado stilių renkatės iš keturių.</p>
            </div>
            <div class="plan-pair">
              {pirtiesPlanai.map((x) => (
                <figure class="plan-panel">
                  <img src={planImg(namelis, x.var)} alt={`ŠK30 su pirtimi, išplanavimas ${x.var}`} loading="lazy">
                  <figcaption><b>Išplanavimas {x.var}</b> · {x.pastaba}</figcaption>
                </figure>
              ))}
            </div>
            <div class="actions" style="margin-top:28px"><a class="btn btn-spruce" href={modelHref(namelis)}>Visi ŠK30 variantai <Arrow /></a></div>
          </div>
        </section>
      )}

      {(p.id === "namas" || p.id === "vanduo") && (
        <section class="section surface" id="irengimas">
          <div class="wrap">
            <div class="sec-head">
              <span class="eyebrow">Įrengimo lygiai</span>
              <h2>Įrengimo lygiai ir kainos</h2>
            </div>
            <Levels />
            <div style="margin-top:56px"><Tech /></div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="wrap faq">
          <div class="faq-head"><span class="eyebrow">DUK</span><h2>Klausimai</h2></div>
          <div class="faq-list">
            {faq.map((q, i) => <details open={i === 0}><summary>{q.klausimas}</summary><p>{q.atsakymas}</p></details>)}
          </div>
        </div>
      </section>

      <section class="section surface">
        <div class="wrap">
          <div class="sec-head"><span class="eyebrow">Taip pat gaminame</span><h2>Kiti pastatai</h2></div>
          <div class="others">
            {others.map((o) => (
              <a class="other" href={productHref(o)}>
                <div class="ph"><img src={img(o.nuotrauka, true)} alt={o.alt} loading="lazy"></div>
                <h3>{o.pavadinimas}</h3>
                <p class="muted">{o.trumpai}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <section class="contact-band">
    <div class="wrap">
      <span class="eyebrow">Susisiekite</span>
      <h2>Aptarkime jūsų projektą.</h2>
      <div class="contact-list">
        {imone.telefonai.map((t) => <a href={telHref(t)}>{t}</a>)}
        <a href={`mailto:${imone.elPastas}`}>{imone.elPastas}</a>
        <small>{imone.vietove}</small>
      </div>
      <div class="actions"><a class="btn btn-amber" href={`kontaktai.html#${p ? p.id : m!.id}`}>Užpildyti užklausą <Arrow /></a></div>
    </div>
  </section>
</Base>
