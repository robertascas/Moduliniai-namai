---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { imone, produktai, turinys, productHref, img, telHref, faqSchema, crumbsSchema, type Produktas } from "../lib/site";

export function getStaticPaths() {
  return produktai.map((p) => ({ params: { produktas: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Produktas };
const others = produktai.filter((x) => x.id !== p.id).slice(0, 3);
const [daline, ikiRakto] = turinys.irengimas;
const faqIds: Record<string, string[]> = {
  namas: ["Kuo skiriasi", "Kiek laiko", "Kur pristatote", "Ar galima pasirinkti", "Ar bus papildomų"],
  pirtis: ["Kokią krosnelę", "Kuo skiriasi", "Kiek laiko", "Kur pristatote", "Ar bus papildomų"],
  sandeliukas: ["Kiek laiko", "Kur pristatote", "Ar galima pasirinkti", "Ar bus papildomų"],
  karkasinis: ["Ar galima pasirinkti", "Kur pristatote", "Kuo skiriasi", "Ar bus papildomų"],
};
const faq = turinys.duk.filter((q) => faqIds[p.id].some((k) => q.klausimas.startsWith(k)));
---
<Base
  path={productHref(p)}
  current={p.id}
  title={`${p.seoTitle} | Šiltas karkasas`}
  description={p.seoDescription}
  schema={[faqSchema(faq), crumbsSchema([{ name: "Pradžia", path: "" }, { name: p.pavadinimas, path: productHref(p) }])]}
>
  <section class="p-hero">
    <div class="p-hero-img">
      <img src={img(p.nuotrauka)} srcset={`${img(p.nuotrauka, true)} 1000w, ${img(p.nuotrauka)} 1800w`} sizes="(max-width: 900px) 100vw, 50vw" alt={p.alt} width="1800" height="1500" fetchpriority="high">
      <span class="viz-note">Vizualizacija</span>
    </div>
    <div class="p-hero-body">
      <span class="crumbs"><a href="index.html">Pradžia</a> / {p.pavadinimas}</span>
      <h1>{p.pavadinimas}</h1>
      <p class="lead">{p.trumpai}</p>
      <div class="actions">
        <a class="btn btn-amber" href={`kontaktai.html#${p.id}`}>Aptarti projektą <Arrow /></a>
        <a class="btn btn-ghost" href={telHref(imone.telefonai[0])}>{imone.telefonai[0]}</a>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Apie</span>
        <h2>{p.pavadinimas}</h2>
        <p class="lead">{p.aprasymas}</p>
      </div>
      <ul class="checks">{p.punktai.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  {p.id !== "karkasinis" && (
    <section class="section" id="irengimas">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Įrengimo lygiai</span>
          <h2>Pasirinkite, kiek darbų atliekame mes.</h2>
        </div>
        <div class="levels">
          <article class="level"><span class="tag-small">1 variantas</span><h3>{daline.pavadinimas}</h3><ul>{daline.punktai.map((x) => <li>{x}</li>)}</ul></article>
          <article class="level featured"><span class="tag-small">2 variantas</span><h3>{ikiRakto.pavadinimas}</h3><p class="plus">Viskas, kas įeina į dalinę apdailą, ir papildomai:</p><ul>{ikiRakto.punktai.map((x) => <li>{x}</li>)}</ul></article>
        </div>
      </div>
    </section>
  )}

  <section class="section surface">
    <div class="wrap faq">
      <div class="faq-head">
        <span class="eyebrow">DUK</span>
        <h2>Klausimai</h2>
      </div>
      <div class="faq-list">
        {faq.map((q, i) => <details open={i === 0}><summary>{q.klausimas}</summary><p>{q.atsakymas}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Taip pat gaminame</span>
        <h2>Kiti pastatai</h2>
      </div>
      <div class="others">
        {others.map((o) => (
          <a class="other" href={productHref(o)}>
            <div class="ph"><img src={img(o.nuotrauka, true)} alt={o.alt} width="1000" height="833" loading="lazy"></div>
            <h3>{o.pavadinimas}</h3>
            <p class="muted">{o.trumpai}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="wrap">
      <span class="eyebrow">Susisiekite</span>
      <h2>Aptarkime jūsų projektą.</h2>
      <div class="contact-list">
        {imone.telefonai.map((t) => <a href={telHref(t)}>{t}</a>)}
        <a href={`mailto:${imone.elPastas}`}>{imone.elPastas}</a>
        <small>{imone.vietove}</small>
      </div>
      <div class="actions"><a class="btn btn-amber" href={`kontaktai.html#${p.id}`}>Užpildyti užklausą <Arrow /></a></div>
    </div>
  </section>
</Base>
